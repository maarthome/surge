+    // A knob turned on the host (e.g. the pi-Stomp display) sets the Surge parameter directly.
+    // The values the host writes while a pedalboard loads must not overwrite the patch, so the
+    // first seconds only note the port values.
+    void applySurgeControlPorts (uint32_t numSteps)
+    {
+        if (controlUrids.empty())
+        {
+            for (int i = 0; i < surgeNumControlPorts; ++i)
+            {
+                const auto iri = lv2_shared::sanitiseStringAsTtlName (URL::addEscapeChars (surgeControlPorts[i].paramId, true));
+                const auto uri = JucePlugin_LV2URI + String (uriSeparator) + iri;
+                controlUrids.push_back (mapFeature.map (mapFeature.handle, uri.toRawUTF8()));
+                controlLast.push_back (-1.0f);
+            }
+        }
+
+        const auto warmedUp = controlSamples >= 3.0 * processor->getSampleRate();
+        controlSamples += numSteps;
+
+        for (int i = 0; i < surgeNumControlPorts; ++i)
+        {
+            const auto* port = ports.getControlPort (i);
+
+            if (port == nullptr)
+                continue;
+
+            const auto v = jlimit (0.0f, 1.0f, *port);
+
+            if (approximatelyEqual (v, controlLast[(size_t) i]))
+                continue;
+
+            const auto first = controlLast[(size_t) i] < 0.0f;
+            controlLast[(size_t) i] = v;
+
+            if (warmedUp && ! first)
+                parameters.setValueFromHost (controlUrids[(size_t) i], v);
+        }
+    }
+
+    std::vector<LV2_URID> controlUrids;
+    std::vector<float> controlLast;
+    double controlSamples = 0.0;
+   #endif
